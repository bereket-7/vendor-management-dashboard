# ============================================
# Application Configuration
# ============================================

NODE_ENV=development

# Frontend URL (Next.js)
NEXT_PUBLIC_URL=http://localhost:3006
NEXT_PUBLIC_APP_URL=http://localhost:3006

# NestJS backend API URL (only needed if you run Nest locally)
NEXT_PUBLIC_API_URL=http://localhost:3001

# ============================================
# Mock vs live (fixture data)
# ============================================
# false — no local fixture data; vendor-core pages use the remote API
# true  — in-memory mocks / fixtures; Nest + vendor-core auth bypassed
# Restart pnpm dev after changing NEXT_PUBLIC_* values.
NEXT_PUBLIC_USE_MOCK=true

# App shell without NestJS: keep true so admin UI opens while data is remote.
# When USE_MOCK=true this is optional (mock auth is already enabled).
NEXT_PUBLIC_DEV_ADMIN=true
# NEXT_PUBLIC_DEV_MANAGER=true
# NEXT_PUBLIC_DEV_VENDOR=true

# ============================================
# Vendor Management Core (Django intake API)
# ============================================
# Do not include /admin/ — that is the Django UI only.
NEXT_PUBLIC_VENDOR_CORE_API_URL=https://api.vm.tillahealth.com
# Local Compose alternative:
# NEXT_PUBLIC_VENDOR_CORE_API_URL=http://localhost:8010

# CLI seed scripts (pnpm seed:vendor-core, pnpm seed:inbound-processing, pnpm seed:errors, pnpm seed:providers, pnpm seed:claim-lines, pnpm seed:member-coverages)
# VENDOR_CORE_USER=
# VENDOR_CORE_PASSWORD=

# Set automatically by pnpm test:e2e (do not enable in production)
# NEXT_PUBLIC_E2E=true
