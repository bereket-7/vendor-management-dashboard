/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"account_id": "aaf626c401196a5414f30a7f3c54dfd9",
	"name": "eligibility-operation",
	"main": ".open-next/worker.js",
	"compatibility_date": "2025-09-27",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets",
	},
	"images": {
		// Enable Cloudflare image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES",
	},
	"services": [
		{
			// Self-reference service binding — name must match the worker name above.
			// Required for OpenNext incremental caching.
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "eligibility-operation",
		},
	],
	"observability": {
		"enabled": true,
	},
	"upload_source_maps": true,
	/**
	 * Smart Placement — uncomment to enable:
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/
	 */
	// "placement": { "mode": "smart" },
	/**
	 * Environment Variables (non-secret)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 *
	 * Set sensitive values as secrets instead:
	 *   wrangler secret put NEXT_PUBLIC_API_URL
	 */
	"vars": {
		"NEXT_PUBLIC_APP_URL": "https://eligibility-operation.3c-health.workers.dev",
		"NEXT_PUBLIC_VENDOR_CORE_API_URL": "https://api.vm.tillahealth.com",
		// NEXT_PUBLIC_API_URL — set via: wrangler secret put NEXT_PUBLIC_API_URL
	},
}
