{
	"name": "template",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@9.15.9",
	"scripts": {
		"clean": "node scripts/clean-next.mjs",
		"dev": "next dev --turbopack -p 3000",
		"dev:clean": "node scripts/clean-next.mjs && next dev --turbopack -p 3000",
		"build": "next build",
		"build:docker": "node scripts/build-docker.mjs",
		"docker:pack": "node scripts/docker-pack.mjs",
		"docker:run": "docker compose -f infra/docker-compose.yml up -d",
		"docker:down": "docker compose -f infra/docker-compose.yml down",
		"docker:logs": "docker compose -f infra/docker-compose.yml logs -f app",
		"docker:up": "pnpm build:docker && pnpm docker:pack && pnpm docker:run",
		"start": "next start",
		"lint": "next lint",
		"prepare": "husky",
		"postinstall": "node scripts/verify-deps.mjs",
		"postinstall:playwright": "playwright install chromium",
		"reinstall": "node scripts/reinstall.mjs",
		"format": "node node_modules/prettier/bin/prettier.cjs --write .",
		"check-types": "tsc --pretty --noEmit",
		"check-format": "node node_modules/prettier/bin/prettier.cjs --check .",
		"test": "jest",
		"test:e2e": "node scripts/run-e2e.mjs",
		"test:e2e:local": "node scripts/run-e2e.mjs --local",
		"test:vendor-core": "node scripts/smoke-vendor-core.mjs",
		"seed:vendor-core": "node scripts/seed-vendor-core-from-mocks.mjs",
		"seed:inbound-processing": "node scripts/seed-inbound-processing.mjs",
		"seed:errors": "node scripts/seed-errors.mjs",
		"seed:providers": "node scripts/seed-providers.mjs",
		"seed:claim-lines": "node scripts/seed-claim-lines.mjs",
		"seed:member-coverages": "node scripts/seed-member-coverages.mjs",
		"test-all": "pnpm run check-types && pnpm run check-format && pnpm run lint && pnpm run test && pnpm run build",
		"analyze": "ANALYZE=true pnpm build"
	},
	"dependencies": {
		"@hookform/resolvers": "^5.0.1",
